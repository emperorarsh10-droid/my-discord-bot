# The Zagrosian Eye — environment template
# Copy to `.env` and fill in real values:   Copy-Item .env.example .env
# `.env` is git-ignored. Never commit real tokens.
# ---------------------------------------------------------------------------

# ==== REQUIRED =============================================================
# Bot token from https://discord.com/developers/applications -> Bot -> Token
#
# NOTE: the Message Content privileged intent must be ON in the developer portal.
# AutoMod's warn/kick escalation ladder and sticky-message reposting run from
# on_message listeners and read message.content. Without that intent Discord
# sends an empty string and those features are silently inert while every slash
# command still looks fine. /test reports this if it is missing.
# Alias: DISCORD_TOKEN is also accepted (config.py AliasChoices).
DISCORD_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Set to false only if you have deliberately disabled the privileged intent and
# accept that AutoMod escalation and stickies will not fire.
MESSAGE_CONTENT_INTENT=true

# ==== HOSTING / PORT =======================================================
# Optional. Render (and most PaaS) inject PORT at runtime and expect the service
# to bind it. When it is set, core/health_server.py starts a tiny HTTP server
# on 0.0.0.0:$PORT answering GET / and GET /health with 200 — an external
# monitor (UptimeRobot, 5 min) pings it so the host never suspends the process
# for idleness. When it is absent nothing is started and no socket is opened,
# which is what you want locally and under systemd.
#
# Do not set this by hand on Render; it provides it. A malformed value is
# logged and ignored rather than crashing the bot.
# PORT=8080

# ==== LOGGING ==============================================================
# Unbuffered output is REQUIRED on Render: without it Python buffers stdout and
# the dashboard shows nothing until the process dies, which looks like a hang.
PYTHONUNBUFFERED=1

# ==== DATABASE =============================================================
# The DSN is normalized on load, so the short forms work too:
#   postgres://user:pass@host:5432/db   ->  postgresql+asyncpg://...
#   sqlite:///./data/zagrosian_eye.db    ->  sqlite+aiosqlite:///...
DATABASE_URL=sqlite+aiosqlite:///./data/zagrosian_eye.db
# Seconds to wait for a DB round-trip before declaring the backend unhealthy.
DATABASE_TIMEOUT=5.0

# ==== OPERATIONS ===========================================================
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=./logs
LOG_MAX_BYTES=10485760         # 10 MiB before rotation
LOG_BACKUP_COUNT=5
# How many log records the live ring keeps for the /status log tail.
LOG_BUFFER=400

# ==== COMMAND SYNC =========================================================
# global = correct for production (up to ~1h propagation)
# guild   = instant, development only, and REQUIRES DEV_GUILD_ID
COMMAND_SYNC_MODE=global
# Only used when COMMAND_SYNC_MODE=guild — instant propagation.
DEV_GUILD_ID=

# ==== SYNC FREQUENCY ========================================================
# if_changed (default) = publish the tree only when its shape actually changed.
#   A global sync costs one HTTP request PER COMMAND against an endpoint Discord
#   throttles hard, and every one of them restarts the propagation timer for
#   every server. Republishing an identical tree on each restart is what makes
#   clients report the bot's commands as outdated for up to an hour.
# always = republish on every start (use when nudging Discord's cache by hand).
# never  = never publish at boot; /sync still works on demand.
SYNC_COMMANDS_ON_START=if_changed

# ==== AUTHORIZATION ========================================================
# Comma separated user IDs allowed to run /test, /reload and /sync.
# Without this, only the Discord application owner can run them.
OWNER_IDS=

# ==== MODERATION DEFAULTS ==================================================
# Hard ceiling for /clear, regardless of what a moderator passes in.
MAX_PURGE_AMOUNT=100
# Human-readable case prefix used in the case-ID (e.g. ZEYE-000142).
CASE_PREFIX=ZEYE
# Role name auto-created by /mute when the guild has no muted role configured.
DEFAULT_MUTE_ROLE=Muted
# DM the offending member when they are punished.
DM_MEMBERS_ON_PUNISH=true
